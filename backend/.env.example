FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=
# Segredo que VOCÊ gera e registra na Pluggy como custom header (X-Webhook-Secret)
# ao criar o webhook via API. O backend confere esse header em cada chamada.
PLUGGY_WEBHOOK_SECRET=
WEBHOOK_BASE_URL=http://localhost:3001
PORT=3001
CORS_ORIGIN=http://localhost:3000
# Limite máximo de transações retornadas por consulta (padrão 200)
TRANSACTIONS_MAX_PAGE_SIZE=200
